# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=india_travel_pal

# JWT Security
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials (Initial Setup)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ── EXTERNAL APIs (Required for Real-Time Data) ──
# Get Railway Key: https://railwayapi.com
RAILWAY_API_KEY=

# Get Amadeus Key: https://developers.amadeus.com (Flight)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Get Google Places Key: https://console.cloud.google.com (Hotels/Food)
GOOGLE_PLACES_KEY=

# Get Uber Token: https://developer.uber.com
UBER_SERVER_TOKEN=

# Get Weather Key: https://openweathermap.org
OPENWEATHER_KEY=
